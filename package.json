{
  "name": "opera-hero",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "copy:wasm": "node scripts/copy-wasm.mjs",
    "predev": "npm run copy:wasm",
    "dev": "vite",
    "prebuild": "npm run copy:wasm",
    "build": "tsc -b && vite build",
    "pretest:e2e": "npm run copy:wasm",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "17.3.0",
    "jsdom": "28.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1",
    "vite": "8.0.13",
    "vitest": "4.1.0"
  }
}
